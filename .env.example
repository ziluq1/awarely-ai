# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git. Do not put a real key in this example file.

# Secret key from your Groq console. The server reads this. It is never sent to the browser.
GROQ_API_KEY=

# Model ID available on your Groq account that supports tool calling.
# Groq's tool-use docs list llama-3.3-70b-versatile for local tool use.
# Confirm that ID in your account before turning calls on.
# The app reads only this variable and does not substitute another model.
GROQ_MODEL=

# Must be the string true to allow a model call. Any other value keeps calls off.
MODEL_CALLS_ENABLED=false

# Optional. Used only when Groq rate-limits the request or cannot answer.
# The server reads this. It is never sent to the browser.
GEMINI_API_KEY=

# Optional model ID. When this is empty and GEMINI_API_KEY is set, the app uses gemini-3.5-flash-lite.
GEMINI_MODEL=

# Public Supabase project URL and publishable key. The browser uses these for sign-in.
# Do not put the service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
