# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git. Do not put a real key in this example file.

# Secret key from your Groq console. The server reads this. It is never sent to the browser.
GROQ_API_KEY=

# Model ID available on your Groq account that supports tool calling.
# Groq's tool-use docs list llama-3.3-70b-versatile for local tool use.
# Confirm that ID in your account before turning calls on.
# The app reads only this variable and does not substitute another model.
GROQ_MODEL=

# Required for live replies. Set the value to true for the Production environment on Vercel, then redeploy.
# true, TRUE, or "true" enables calls. Any other value, including an empty value, keeps demo mode on.
MODEL_CALLS_ENABLED=false

# Optional. Used only when Groq rate-limits the request or cannot answer.
# The server reads this. It is never sent to the browser.
GEMINI_API_KEY=

# Optional model ID. When this is empty and GEMINI_API_KEY is set, the app uses gemini-3.5-flash-lite.
GEMINI_MODEL=

# Public Supabase project URL and publishable key. The browser uses these for sign-in.
# Do not put the service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Used for Google sign-in only when the browser is not on localhost
# and not on https://awarely-ai.vercel.app. Signup and password reset ignore it.
# Leave this empty. Do not point it at a domain that does not run this app.
NEXT_PUBLIC_SITE_URL=

# Server only. Supabase secret key, also called the service-role key.
# The account-deletion route reads this. Never prefix it with NEXT_PUBLIC_.
# Leave it empty until you copy the secret key from the Supabase dashboard.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile site key (public). Required for login, signup, and password-reset forms.
# Optional. When set, the login/signup/reset forms show Turnstile and pass captchaToken if a token is ready.
# Forms still submit if the widget is missing or fails. Put any Turnstile secret only in Supabase CAPTCHA settings.
# Restart next dev after changing this value. For local testing, use Cloudflare's test site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
